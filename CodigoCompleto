    "Sentadilla": ("carga", [0.75, 1.0, 1.5, 2.0], [0.5, 0.75, 1.25, 1.75]),
    "Cargas en pecho": ("carga", [0.5, 0.75, 1.0, 1.5], [0.25, 0.5, 0.75, 1.0]),
    "Cargas en espalda": ("carga", [0.5, 0.75, 1.0, 1.25], [0.3, 0.5, 0.75, 1.0]),
    "Extension de cuadriceps": ("carga", [0.4, 0.7, 1.0, 1.4], [0.25, 0.5, 0.75, 1.1]),
    "Peso muerto": ("carga", [1.0, 1.5, 2.0, 2.5], [0.75, 1.25, 1.75, 2.25]),
    "Press militar": ("carga", [0.35, 0.55, 0.8, 1.1], [0.2, 0.35, 0.55, 0.8]),
    "Curl de biceps": ("carga", [0.2, 0.4, 0.6, 0.8], [0.1, 0.25, 0.4, 0.6]),
    "Flexiones": ("corporal", [10, 20, 35, 50], [5, 12, 25, 40]),
    "Abdominales": ("corporal", [20, 30, 40, 50], [15, 25, 35, 45]),
    "Dominadas": ("corporal", [1, 5, 10, 15], [1, 3, 6, 10]),
