def pedir_texto(mensaje):
    texto = input(mensaje)

    while texto == "":
        print("Este dato es obligatorio.")
        texto = input(mensaje)

    return texto


def pedir_numero(mensaje, minimo, maximo=100000):
    numero = float(input(mensaje))

    while numero < minimo or numero > maximo:
        print("Número incorrecto.")
        numero = float(input(mensaje))

    return numero


def pedir_cedula(mensaje):
    cedula = input(mensaje)

    while not cedula.isdigit() or len(cedula) < 6 or len(cedula) > 10:
        print("La cédula debe tener solo números (entre 6 y 10 dígitos).")
        cedula = input(mensaje)

    return cedula


def pedir_genero():
    genero = input("Género (H = Hombre, M = Mujer): ")

    while genero != "H" and genero != "h" and genero != "M" and genero != "m":
        print("Escribe H o M.")
        genero = input("Género (H = Hombre, M = Mujer): ")

    if genero == "H" or genero == "h":
        return "Hombre"
    else:
        return "Mujer"


class Deportista:

    def __init__(self, id, nombre, edad, genero, peso, estatura, deporte):
        self.id = id
        self.nombre = nombre
        self.edad = edad
        self.genero = genero
        self.peso = peso
        self.estatura = estatura
        self.deporte = deporte
        self.ejercicios = {}
        self.rendimiento = 0
        self.rango = "Principiante"
        self.imc = self.calcular_imc()

    def calcular_imc(self):
        return self.peso / (self.estatura * self.estatura)

    def clasificar_imc(self):
        if self.imc < 18.5:
            return "Bajo peso"
        elif self.imc < 25:
            return "Peso normal"
        elif self.imc < 30:
            return "Sobrepeso"
        else:
            return "Obesidad"

    def calcular_rango(self):
        if self.rendimiento < 50:
            return "Principiante"
        elif self.rendimiento < 70:
            return "Básico"
        elif self.rendimiento < 85:
            return "Intermedio"
        elif self.rendimiento < 95:
            return "Avanzado"
        else:
            return "Élite"

    def calcular_nivel_ejercicio(self, ejercicio, valor):
        tipo = EJERCICIOS[ejercicio][0]

        if self.genero == "Hombre":
            limites = EJERCICIOS[ejercicio][1]
        else:
            limites = EJERCICIOS[ejercicio][2]

        if tipo == "carga":
            valor = valor / self.peso

        posicion = 0

        for limite in limites:
            if valor >= limite:
                posicion = posicion + 1

        return NIVELES[posicion]

    def registrar_ejercicio(self, ejercicio, valor):
        nivel = self.calcular_nivel_ejercicio(ejercicio, valor)
        self.ejercicios[ejercicio] = nivel
        self.calcular_rendimiento()
        return nivel

    def calcular_rendimiento(self):
        total = 0
        cantidad = 0

        for ejercicio in self.ejercicios:
            nivel = self.ejercicios[ejercicio]
            posicion = 0

            for nombre in NIVELES:
                if nombre == nivel:
                    total = total + PUNTOS[posicion]
                posicion = posicion + 1

            cantidad = cantidad + 1

        if cantidad > 0:
            self.rendimiento = round(total / cantidad)

        self.rango = self.calcular_rango()

    def actualizar_rendimiento(self, nuevo):
        self.rendimiento = nuevo
        self.rango = self.calcular_rango()

    def progreso_siguiente_rango(self):
        if self.rango == "Élite":
            print("¡Has alcanzado el nivel más alto!")
        else:
            posicion = 0

            for nivel in NIVELES:
                if nivel == self.rango:
                    break
                posicion = posicion + 1

            siguiente = NIVELES[posicion + 1]
            necesario = LIMITES_RANGO[posicion]
            faltan = necesario - self.rendimiento

            print("Siguiente rango:", siguiente)
            print("Rendimiento necesario:", necesario)
            print("Puntos que faltan:", faltan)

    def mostrar(self):
        print("\n--- Deportista ---")
        print("Cédula (ID):", self.id)
        print("Nombre:", self.nombre)
        print("Edad:", self.edad)
        print("Género:", self.genero)
        print("Peso:", self.peso, "kg")
        print("Estatura:", self.estatura, "m")
        print("IMC:", round(self.imc, 2), self.clasificar_imc())
        print("Deporte:", self.deporte)

        if self.ejercicios == {}:
            print("No hay ejercicios registrados.")
        else:
            print("Ejercicios:")

            for ejercicio in self.ejercicios:
                print(ejercicio, ":", self.ejercicios[ejercicio])

        print("Rendimiento:", self.rendimiento)
        print("Rango:", self.rango)
        self.progreso_siguiente_rango()


class Gimnasio:

    def __init__(self):
        self.deportistas = []

    def registrar(self, deportista):
        self.deportistas.append(deportista)

    def buscar(self, id):
        for deportista in self.deportistas:
            if deportista.id == id:
                return deportista
        return None

    def eliminar(self, deportista):
        self.deportistas.remove(deportista)

    def mostrar_deportistas(self):
        if self.deportistas == []:
            print("No hay deportistas registrados.")

        for deportista in self.deportistas:
            deportista.mostrar()

    def mostrar_clasificacion(self):
        if self.deportistas == []:
            print("No hay deportistas registrados.")
            return

        ordenados = []
        cantidad = 0

        for deportista in self.deportistas:
            ordenados.append(deportista)
            cantidad = cantidad + 1

        i = 0

        while i < cantidad:
            j = 0

            while j < cantidad - 1:
                if ordenados[j].rendimiento < ordenados[j + 1].rendimiento:
                    temporal = ordenados[j]
                    ordenados[j] = ordenados[j + 1]
                    ordenados[j + 1] = temporal

                j = j + 1

            i = i + 1

        print("\n===== CLASIFICACIÓN =====")

        puesto = 1

        for deportista in ordenados:
            print(puesto, deportista.nombre,
                  "- Rendimiento:", deportista.rendimiento,
                  "- Rango:", deportista.rango)

            puesto = puesto + 1


def registrar_deportista(gimnasio):
    print("\n--- Registrar deportista ---")

    id = pedir_cedula("Cédula (será el ID): ")

    if gimnasio.buscar(id) is not None:
        print("Ya existe un deportista con esa cédula.")
        return

    nombre = pedir_texto("Nombre: ")
    edad = int(pedir_numero("Edad: ", 1, 100))
    genero = pedir_genero()
    peso = pedir_numero("Peso (kg): ", 1, 400)
    estatura = pedir_numero("Estatura (m): ", 0.5, 2.5)
    deporte = pedir_texto("Deporte: ")

    deportista = Deportista(id, nombre, edad, genero, peso, estatura, deporte)
    gimnasio.registrar(deportista)

    print("Deportista registrado correctamente.")
    print("ID (cédula):", id)
    print("IMC:", round(deportista.imc, 2))
    print("Clasificación:", deportista.clasificar_imc())


def registrar_ejercicio(gimnasio):
    print("\n--- Registrar ejercicio ---")

    id = input("Cédula del deportista: ")
    deportista = gimnasio.buscar(id)

    if deportista is None:
        print("No se encontró el deportista.")
        return

    print("\nEjercicios disponibles:")

    nombres = []

    for ejercicio in EJERCICIOS:
        nombres.append(ejercicio)

    numero = 1

    for ejercicio in nombres:
        print(numero, ejercicio)
        numero = numero + 1

    opcion = int(pedir_numero("Elige un ejercicio: ", 1, 11))

    numero = 1

    for ejercicio in nombres:
        if numero == opcion:
            elegido = ejercicio
        numero = numero + 1

    tipo = EJERCICIOS[elegido][0]

    if tipo == "carga":
        valor = pedir_numero("Peso máximo levantado en kg: ", 0)
    else:
        valor = pedir_numero("Repeticiones o segundos: ", 0)

    nivel = deportista.registrar_ejercicio(elegido, valor)

    print("Nivel del ejercicio:", nivel)
    print("Rendimiento general:", deportista.rendimiento)
    print("Rango actual:", deportista.rango)
    deportista.progreso_siguiente_rango()


def registrar_rendimiento(gimnasio):
    print("\n--- Registrar rendimiento manual ---")

    id = input("Cédula del deportista: ")
    deportista = gimnasio.buscar(id)

    if deportista is None:
        print("No se encontró el deportista.")
        return

    nuevo = int(pedir_numero("Nuevo rendimiento (0 a 100): ", 0, 100))
    deportista.actualizar_rendimiento(nuevo)

    print("Rendimiento actualizado.")
    print("Rango actual:", deportista.rango)
    deportista.progreso_siguiente_rango()


def consultar_deportista(gimnasio):
    print("\n--- Consultar deportista ---")

    id = input("Cédula del deportista: ")
    deportista = gimnasio.buscar(id)

    if deportista is None:
        print("No se encontró el deportista.")
    else:
        deportista.mostrar()


def actualizar_informacion(gimnasio):
    print("\n--- Actualizar información ---")

    id = input("Cédula del deportista: ")
    deportista = gimnasio.buscar(id)

    if deportista is None:
        print("No se encontró el deportista.")
        return

    print("1. Nombre")
    print("2. Edad")
    print("3. Peso")
    print("4. Estatura")
    print("5. Deporte")

    opcion = input("¿Qué deseas actualizar?: ")

    if opcion == "1":
        deportista.nombre = pedir_texto("Nuevo nombre: ")
    elif opcion == "2":
        deportista.edad = int(pedir_numero("Nueva edad: ", 1, 100))
    elif opcion == "3":
        deportista.peso = pedir_numero("Nuevo peso: ", 1, 400)
        deportista.imc = deportista.calcular_imc()
    elif opcion == "4":
        deportista.estatura = pedir_numero("Nueva estatura: ", 0.5, 2.5)
        deportista.imc = deportista.calcular_imc()
    elif opcion == "5":
        deportista.deporte = pedir_texto("Nuevo deporte: ")
    else:
        print("Opción incorrecta.")
        return

    print("Información actualizada correctamente.")


def eliminar_deportista(gimnasio):
    print("\n--- Eliminar deportista ---")

    id = input("Cédula del deportista: ")
    deportista = gimnasio.buscar(id)

    if deportista is None:
        print("No se encontró el deportista.")
        return

    confirmar = input("¿Eliminar a " + deportista.nombre + "? (s/n): ")

    if confirmar == "s" or confirmar == "S":
        gimnasio.eliminar(deportista)
        print("Deportista eliminado.")
    else:
        print("Operación cancelada.")


